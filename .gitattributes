# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Declare files that will otherwise have CRLF line endings on checkout.
.* text=auto eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.php text eol=lf
*.pot text eol=lf
*.ps1 text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf

# Denote all files that are truly binary and should not be modified.
*.eot binary
*.jpg binary
*.png binary
*.ttf binary
*.woff binary
*.woff2 binary

# Left out of release archives (git archive and the WordPress.org zip).
# Every root path that starts with a dot: .claude, .codex, .cursor, .github, .local, .vscode, and the rest.
/.* export-ignore

# Root development files that do not start with a dot.
AGENTS.md export-ignore
AGENTS.override.md export-ignore
README.md export-ignore
composer.json export-ignore
cspell.json export-ignore
phpcs.xml export-ignore
